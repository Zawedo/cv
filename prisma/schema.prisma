generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  displayName String?      @unique
  createdAt   DateTime     @default(now())
  sessions     Session[]
  predictions  Prediction[]
  bracketPicks BracketPick[]
}

model LoginToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// league : LCK | LEC | LCS | LPL
/// status : UPCOMING | LIVE | FINISHED | CANCELED
model Match {
  id          String       @id @default(cuid())
  externalId  String       @unique
  league      String
  tournament  String
  stage       String?
  team1       String
  team2       String
  bestOf      Int          @default(3)
  startTime   DateTime
  status      String       @default("UPCOMING")
  team1Score  Int?
  team2Score  Int?
  winner      Int?
  manual      Boolean      @default(false)
  updatedAt   DateTime     @updatedAt
  predictions Prediction[]

  @@index([league, startTime])
  @@index([status, startTime])
}

model Prediction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team1Score Int
  team2Score Int
  points     Int?
  exact      Boolean?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, matchId])
  @@index([matchId])
}

/// Logos d'équipes (récupérés depuis Leaguepedia pendant la synchro)
model Team {
  name      String    @id
  logoUrl   String?
  checkedAt DateTime?
}

/// Tableau final d'un tournoi international. event : MSI | WORLDS. format : SINGLE_ELIM_8 | DOUBLE_ELIM_8
/// seeds : JSON des 8 équipes dans l'ordre du premier tour. results : JSON { nœud: équipe gagnante }
model Bracket {
  id        String        @id @default(cuid())
  slug      String        @unique
  name      String
  event     String
  format    String
  seeds     String
  results   String        @default("{}")
  lockAt    DateTime
  manual    Boolean       @default(false)
  updatedAt DateTime      @updatedAt
  picks     BracketPick[]
}

model BracketPick {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bracketId String
  bracket   Bracket  @relation(fields: [bracketId], references: [id], onDelete: Cascade)
  picks     String   @default("{}")
  points    Int?
  correct   Int?
  updatedAt DateTime @updatedAt

  @@unique([userId, bracketId])
}
