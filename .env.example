# Base de données (SQLite en local ; voir README pour PostgreSQL en prod)
DATABASE_URL="file:./dev.db"

# URL publique du site (utilisée dans les liens des messages Slack)
APP_URL="http://localhost:3000"

# Clé du lien admin : ouvrir APP_URL/admin/acces?cle=<ADMIN_KEY> (16 caractères minimum)
ADMIN_KEY=""

# Secret pour l'appel du cron de synchronisation : Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me"

# Slack (optionnel). Bot : messages privés de rappel (scopes chat:write, users:read, users:read.email).
SLACK_BOT_TOKEN=""
# Chaîne de la communauté : webhook entrant, OU identifiant de chaîne où le bot est invité
SLACK_WEBHOOK_URL=""
SLACK_CHANNEL_ID=""

# Source des matchs : "leaguepedia" (défaut) ou "none" (saisie manuelle uniquement)
MATCH_PROVIDER="leaguepedia"
