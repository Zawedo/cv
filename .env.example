# Base de données (SQLite en local ; voir README pour PostgreSQL en prod)
DATABASE_URL="file:./dev.db"

# URL publique du site (utilisée dans les liens de connexion envoyés par email)
APP_URL="http://localhost:3000"

# Seules les adresses de ces domaines peuvent se connecter (séparés par des virgules)
ALLOWED_EMAIL_DOMAINS="winamax.fr,winamax.com"

# Emails des administrateurs (synchro manuelle, saisie de résultats)
ADMIN_EMAILS=""

# Secret pour l'appel du cron de synchronisation : Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me"

# SMTP pour l'envoi des liens magiques. Si vide hors production, le lien s'affiche dans la console.
SMTP_URL=""
MAIL_FROM="Winamax LoL Pronos <pronos@winamax.fr>"

# Source des matchs : "leaguepedia" (défaut) ou "none" (saisie manuelle uniquement)
MATCH_PROVIDER="leaguepedia"
